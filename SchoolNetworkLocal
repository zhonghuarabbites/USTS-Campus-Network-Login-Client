    def init_monitor_state(self):
        """初始化定时检测/自动拨号所需的全部状态。

        注意：tkinter 不是线程安全的，后台线程只做网络操作，
        任何界面刷新都必须通过 _ui() 用 root.after 投递回主线程执行。
        """
        self._monitor_thread = None
        self._monitor_stop = threading.Event()   # 置位表示要求线程退出
        self._monitor_wake = threading.Event()   # 用于可被立即打断的 sleep
        self._monitor_lock = threading.Lock()    # 保护"拨号中"标记
        self._offline_streak = 0                 # 连续检测失败次数
        self._last_dial_ts = 0.0                 # 上次自动拨号的时间（time.monotonic）
        self._auto_login_running = False         # 是否正在自动拨号，避免并发拨号
        self._dial_failed_last = False           # 上一次自动拨号是否失败
        self._auto_paused = False                # 手动注销后暂停自动拨号，避免注销完立刻被重新登录

        # 主线程维护的凭证快照，供后台线程读取（跨线程读取 Tk 变量是不安全的）
        self._cred = {"username": "", "password": "", "carrier": "@xyw"}

        # 检测间隔 / 连续失败阈值：后台线程读的是这两个纯 Python 属性
        self._interval = ServerConfig.AUTO_CHECK_INTERVAL_DEFAULT
        self._fail_threshold = ServerConfig.AUTO_FAIL_THRESHOLD_DEFAULT

        try:
            cfg_interval = int(self.config.get("check_interval", ServerConfig.AUTO_CHECK_INTERVAL_DEFAULT))
        except (TypeError, ValueError):
            cfg_interval = ServerConfig.AUTO_CHECK_INTERVAL_DEFAULT
        self._interval = max(
            ServerConfig.AUTO_CHECK_INTERVAL_MIN,
            min(ServerConfig.AUTO_CHECK_INTERVAL_MAX, cfg_interval)
        )

        try:
            cfg_threshold = int(self.config.get("fail_threshold", ServerConfig.AUTO_FAIL_THRESHOLD_DEFAULT))
        except (TypeError, ValueError):
            cfg_threshold = ServerConfig.AUTO_FAIL_THRESHOLD_DEFAULT
        self._fail_threshold = max(1, min(10, cfg_threshold))

