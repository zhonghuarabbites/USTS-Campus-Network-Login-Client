    # ============================================================
    # 改进点【load_config / save_config】：
    # 1. 裸except替换为具体异常类型（json.JSONDecodeError, IOError/OSError）
    # 2. save_config增加异常处理，防止文件不可写时崩溃
    # ============================================================
    def load_config(self):
        self.config = {}
        if os.path.exists(self.config_file):
            try:
                with open(self.config_file, "r", encoding="utf-8") as f:
                    self.config = json.load(f)
            except json.JSONDecodeError as e:
                # 配置文件JSON格式错误时给出明确提示
                messagebox.showwarning("配置警告", f"配置文件格式错误({e})，将使用默认配置")
                self.config = {}
            except IOError as e:
                # 文件读取权限等IO异常
                messagebox.showwarning("配置警告", f"读取配置文件失败: {e}，将使用默认配置")
                self.config = {}
            except OSError as e:
                messagebox.showwarning("配置警告", f"操作系统错误: {e}，将使用默认配置")
                self.config = {}

    def save_config(self):
        carrier_name = self.carrier_var.get()
        carrier_suffix = self.CARRIERS.get(carrier_name, "@xyw")

        # 新增：自动重连相关设置一并持久化（getattr 兼容控件尚未创建的调用场景）
        auto_reconnect = bool(self.auto_var.get()) if hasattr(self, "auto_var") else True
        check_interval = self._interval
        fail_threshold = self._fail_threshold

        if self.remember_var.get():
            config = {
                "username": self.username_var.get(),
                "password": self.password_var.get(),
                "carrier": carrier_suffix,
                "remember": True
            }
        else:
            config = {"remember": False}

        config.update({
            "auto_reconnect": auto_reconnect,
            "check_interval": check_interval,
            "fail_threshold": fail_threshold
        })

        try:
            with open(self.config_file, "w", encoding="utf-8") as f:
                json.dump(config, f, ensure_ascii=False, indent=2)
        except IOError as e:
            # 改进点：save_config原来没有异常处理，文件不可写时会崩溃
            messagebox.showerror("保存失败", f"无法保存配置文件: {e}")
        except OSError as e:
            messagebox.showerror("保存失败", f"操作系统错误，无法保存配置: {e}")

    # ============================================================
    # 改进点【get_local_ip】：
    # 1. 裸except替换为socket.error
    # 2. 默认IP提取为ServerConfig常量
    # ============================================================
    def get_local_ip(self):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect((ServerConfig.SOCKET_CONNECT_IP, ServerConfig.SOCKET_CONNECT_PORT))
            ip = s.getsockname()[0]
            s.close()
            return ip
        except socket.error as e:
            # 改进：使用具体异常类型socket.error而非裸except
            return ServerConfig.DEFAULT_LOCAL_IP

    # ============================================================
    # 改进点【check_online_status】：
    # 1. 裸except替换为具体异常
    # 2. 超时从5秒提升到10秒
    # 3. 增加重试机制
    # ============================================================
    def check_online_status(self, timeout=None, retries=None):
        """检查当前在线状态，带重试机制

        新增参数：timeout / retries 可覆盖默认值，
        后台定时检测会传入更短的超时和更少的重试次数，避免长时间阻塞影响检测频率。
        """
        if timeout is None:
            timeout = ServerConfig.CHECK_STATUS_TIMEOUT
        if retries is None:
            retries = ServerConfig.CHECK_STATUS_RETRY_COUNT
        retries = max(1, int(retries))

        for attempt in range(retries):
            try:
                req = urllib.request.Request(ServerConfig.STATUS_URL)
                req.add_header(
                    "User-Agent",
                    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
                )

                with urllib.request.urlopen(req, timeout=timeout) as response:
                    result = response.read().decode("utf-8", errors="ignore")
                    if '"result":1' in result or '"result": 1' in result:
                        return True
                    return False
            except urllib.error.URLError as e:
                # 改进：捕获具体异常类型urllib.error.URLError
                if attempt < retries - 1:
                    # 还有重试机会，等待后重试
                    time.sleep(ServerConfig.CHECK_STATUS_RETRY_DELAY)
                    continue
                return False
            except socket.timeout as e:
                # 改进：单独处理超时异常
                if attempt < retries - 1:
                    time.sleep(ServerConfig.CHECK_STATUS_RETRY_DELAY)
                    continue
                return False
            except Exception as e:
                # 其他未知异常也重试
                if attempt < retries - 1:
                    time.sleep(ServerConfig.CHECK_STATUS_RETRY_DELAY)
                    continue
                return False
        return False

    # ============================================================
    # 改进点【login】：
